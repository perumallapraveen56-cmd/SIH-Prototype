# SIH26017 Land Acquisition Delay Prediction System
# Backend Environment Configuration Template

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
SQLITE_FALLBACK_URL=sqlite:///./land_acquisition.db

# Authentication / JWT Security (Generate with: openssl rand -hex 32)
SECRET_KEY=<YOUR_PRODUCTION_JWT_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=https://<YOUR_FRONTEND_DOMAIN>,http://localhost:4200,http://127.0.0.1:4200

# Application Settings
ENABLE_SOUND_ALERTS=true
ALERT_REFRESH_INTERVAL_SECONDS=15
DEMO_DATA_MODE=false
