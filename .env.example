# SIH26017 Land Acquisition Delay Prediction System
# Environment Configuration Template

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/land_acquisition_db
SQLITE_FALLBACK_URL=sqlite:///./land_acquisition.db

# Authentication / JWT
SECRET_KEY=nexora-tau-sih26017-super-secret-security-key-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Application Settings
ENABLE_SOUND_ALERTS=true
ALERT_REFRESH_INTERVAL_SECONDS=15
DEMO_DATA_MODE=true
